# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
node_modules/

# Runtime artifacts (must not churn git)
*.db
*.db-journal
*.db-wal
*.db-shm
*.log
*.pid
ex10_exhibits_export.json
# Live backend-comparison capture + window marker (regenerated each run)
rust_ingest_capture.jsonl
comparison_window.txt

# Secrets / local env (never commit; .env.example is the committed template)
.env
*.env
!*.env.example
!.env.example

# Astro / Cloudflare build output
frontend/dist/
frontend/.astro/
.wrangler/
.dev.vars


# HF Space staged build context (regenerated by build-context.sh)
deploy/hf-space/sec_listener/
deploy/hf-space/seed.db

# Local data snapshots (parquet mirror / exports)
*.parquet

# Unrelated embedded clone (not part of this repo)
secinfra-rust/
.staging_sec_api_key
