# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Every key below maps 1:1 to backend-rust/src/config.rs.

# ── REQUIRED ────────────────────────────────────────────────────────────────
# D1 ingest route that finalized EX-10 rows are POSTed to. Production value:
D1_INGEST_URL=https://live-contracts.arthur.law/api/ingest
# Shared secret, sent as the `X-API-Key` header. MUST match the ingest route's
# configured key, or every POST is rejected. REQUIRED: docker compose fails fast
# if this is empty (and the README documents it as required).
SEC_API_KEY=

# ── DISCOVERY (datamule-style; both on is recommended) ───────────────────────
# RSS = fast/near-real-time getcurrent feed; EFTS = accuracy backstop that sweeps
# up filings RSS drops. Validated 100% parity with the Python listener.
SEC_USE_RSS=true
SEC_USE_EFTS=true
SEC_POLL_INTERVAL_MS=200

# ── OUTPUT / TUNING ──────────────────────────────────────────────────────────
SEC_CONVERT_MARKDOWN=true
SEC_PUSH_BATCH=100          # rows per POST (hard-capped at 200 by the route)
PORT=7860                   # container port the app binds — keep >= 1024 (runs as non-root)
HOST_PORT=7860              # host port published on 127.0.0.1; point the tunnel here
RUST_LOG=info

# ── IMAGES (optional) ────────────────────────────────────────────────────────
# HF token to capture & upload scanned (image-only) exhibit images to the HF
# dataset. Leave blank to skip image capture entirely.
HF_TOKEN=
SEC_IMAGE_REPO=arthrod/sec-ex10-exhibits

# Cloudflare tunnel: nothing to configure here — your existing tunnel routes to
# http://localhost:7860 (the published health port). No token needed.
