# SEC EX-10 listener configuration (copy to .env, values are examples)
SEC_DB_PATH=ex10_listener.db
SEC_POLL_INTERVAL=60
SEC_RUN_HOURS=0
SEC_RPS=5
SEC_CONVERT_MARKDOWN=true
SEC_USER_AGENT=SEC EX-10 Listener your-email@example.com

# Internal API (PR2) — never expose this to the public internet
SEC_API_KEY=change-me-to-a-long-random-secret
SEC_API_HOST=127.0.0.1
SEC_API_PORT=8799

# Worker (PR3)
SEC_BACKFILL_BATCH=25
