{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "objectWrap": "preserve",
  "endOfLine": "lf",
  "quoteProps": "as-needed",
  "proseWrap": "preserve",
  "astro": {
    "compressHTML": "none"
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".astro",
    ".wrangler",
    "dogfood-output",
    "pnpm-lock.yaml",
    "bun.lock",
    "**/*.css"
  ]
}
