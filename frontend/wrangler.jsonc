{
  // Cloudflare Workers deploy config for the Astro 6 frontend.
  // Build first (`bun run build`), then `wrangler deploy` from this directory.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sec-ex10-frontend",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    // Internal links omit trailing slashes; serve those directly (no 307 hop).
    "html_handling": "drop-trailing-slash"
  },
  // Sessions KV (created via `wrangler kv namespace create SESSION`).
  "kv_namespaces": [
    { "binding": "SESSION", "id": "f3559549c63e48cf8af7500331ceb1cf" }
  ],
  // D1 is the durable, authoritative EX-10 content store (read by the Worker
  // via Drizzle over the `DB` binding; written by the HF worker through
  // /api/ingest). Created via `wrangler d1 create sec-ex10`.
  "d1_databases": [
    { "binding": "DB", "database_name": "sec-ex10", "database_id": "dfb55595-bebe-4d5f-80e6-658538ad3da8" }
  ],
  // The backend API runs as a Hugging Face Space (key-gated). The Worker fetches
  // it at request time and caches at the edge (CDN + stale-while-revalidate).
  // SEC_API_KEY is a secret: `wrangler secret put SEC_API_KEY`.
  "vars": {
    "SEC_API_URL": "https://arthrod-sec-ex10-api.hf.space"
  },
  // Public custom domain (the arthur.law zone is already on this Cloudflare
  // account). `wrangler deploy` provisions the hostname + edge cert; no manual
  // DNS record needed for a Workers custom domain.
  "routes": [
    { "pattern": "live-contracts.arthur.law", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
