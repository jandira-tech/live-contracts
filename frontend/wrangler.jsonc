{
  // Cloudflare Workers deploy config for the Astro 6 frontend.
  // Build first (`bun run build`), then `wrangler deploy` from this directory.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sec-ex10-frontend",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    // Internal links omit trailing slashes; serve those directly (no 307 hop).
    "html_handling": "drop-trailing-slash"
  },
  // Sessions KV (created via `wrangler kv namespace create SESSION`).
  "kv_namespaces": [
    { "binding": "SESSION", "id": "f3559549c63e48cf8af7500331ceb1cf" }
  ],
  // D1 is the durable, authoritative EX-10 content store (read by the Worker
  // via Drizzle over the `DB` binding; written by the HF worker through
  // /api/ingest). Created via `wrangler d1 create sec-ex10`.
  "d1_databases": [
    { "binding": "DB", "database_name": "sec-ex10", "database_id": "dfb55595-bebe-4d5f-80e6-658538ad3da8" }
  ],
  // SEC_API_KEY is a secret (set via `wrangler secret put SEC_API_KEY`); PR3's
  // /api/ingest reuses it to gate writes. The read path is D1 now, so the
  // former SEC_API_URL var is removed.
  // Public custom domain (the arthur.law zone is already on this Cloudflare
  // account). `wrangler deploy` provisions the hostname + edge cert; no manual
  // DNS record needed for a Workers custom domain.
  "routes": [
    { "pattern": "live-contracts.arthur.law", "custom_domain": true }
  ],
  "observability": { "enabled": true },

  // Staging: an isolated copy of the frontend on a *.workers.dev URL (no custom
  // domain), backed by its own D1 (`sec-ex10-staging`) and SESSION KV. Used to
  // receive ingest from the Rust backend (`backend-rust`) via /api/ingest so the
  // Rust pipeline can be exercised without touching the Python-fed prod `sec-ex10`
  // DB. Bindings are NOT inherited from the top level, so DB/SESSION are
  // redeclared here pointing at the staging resources. Deploy: `wrangler deploy
  // --env staging`; secret: `wrangler secret put SEC_API_KEY --env staging`.
  "env": {
    "staging": {
      "name": "sec-ex10-frontend-staging",
      "kv_namespaces": [
        { "binding": "SESSION", "id": "b82f3dc113814af999838c4f1892e58a" }
      ],
      "d1_databases": [
        { "binding": "DB", "database_name": "sec-ex10-staging", "database_id": "2d70ff84-8abc-457c-b483-656194217fd2" }
      ],
      "observability": { "enabled": true }
    }
  }
}
