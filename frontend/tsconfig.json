{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  // `test/` is type-checked by Vitest (vitest.config.ts) with the Workers pool,
  // which provides the virtual `cloudflare:test` module. `scripts/` are operator
  // scripts run under Node with their own scripts/tsconfig.json. `astro check`
  // validates the app, not those harnesses, so both are excluded here.
  "exclude": ["dist", "test", "scripts"]
}
