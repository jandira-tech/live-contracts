{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  // `test/` is type-checked by Vitest (vitest.config.ts) with the Workers pool,
  // which provides the virtual `cloudflare:test` module. `astro check` validates
  // the app, not the test harness, so it's excluded here.
  "exclude": ["dist", "test"]
}
