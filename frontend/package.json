{
  "name": "sec-ex10-frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "sync": "astro sync",
    "test:fonts": "node test/fonts.mjs",
    "test:design": "node test/design-system.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:unit": "vitest run",
    "fmt": "oxfmt",
