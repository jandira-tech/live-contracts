  "trustedDependencies": [
    "esbuild",
    "workerd",
    "sharp",
    "@cloudflare/workerd-linux-64"
  ],
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/compiler-rs": "^0.5.2",
    "@cloudflare/vitest-pool-workers": "^0.17.0",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^6.0.3",
