---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Inject <meta refresh> for live auto-refresh pages. */
  refreshSeconds?: number;
}

const {
  title = 'SEC EX-10 Live — Material Contracts',
  description = 'Real-time feed of EX-10 material contract exhibits filed with the SEC.',
  refreshSeconds,
} = Astro.props;

// Active nav state from the current path.
const path = Astro.url.pathname;
const isHome = path === '/';
const isBrowse = path.startsWith('/agreement'); // /agreements/* and /agreement/*
const isSearch = path.startsWith('/search');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* Without JS the page still refreshes itself; with JS, index.astro polls and
        inserts new rows in place so scroll position survives. */}
    {refreshSeconds ? <noscript><meta http-equiv="refresh" content={String(refreshSeconds)} /></noscript> : null}
    <title>{title}</title>
    <!-- Canonical brand fonts are self-hosted (see global.css @font-face); preload
         the two variable woff2 so first paint isn't blocked on CSS discovery. -->
    <link rel="preload" href="/fonts/libre-franklin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roboto-mono.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Text-size preference (A / A+), applied before first paint to avoid a flash.
      try { var s = localStorage.getItem('asr-size'); if (s === 'large') document.documentElement.dataset.size = 'large'; } catch (e) {}
    </script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' fill='%23FAFAF8'/><rect x='3' y='3' width='5' height='5' fill='%23FFD400'/></svg>" />
  </head>
  <body>
    <header class="hdr">
      <div class="wrap">
        <div class="brand">
          <a class="wm" href="https://arthur.law/">ARTHUR<i>.</i>SOUZA<i>.</i>RODRIGUES</a>
          <a class:list={['sub', 'mono', { 'is-current': isHome }]} href="/">/ Live contracts</a>
        </div>
        <div class="hright">
          <ul class="nav-links">
            <li><a class:list={[{ 'is-current': isHome }]} href="/"><span class="live" aria-hidden="true"></span>Live</a></li>
            <li><a class:list={[{ 'is-current': isBrowse }]} href="/agreements/1">Browse</a></li>
            <li><a class:list={[{ 'is-current': isSearch }]} href="/search">Search</a></li>
            <li><a class="nav-contact" href="https://arthur.law/contact/">Contact →</a></li>
          </ul>
          <div class="sizes" aria-label="Text size">
            <button type="button" data-size="normal" class="on" title="Default text size">A</button>
            <button type="button" data-size="large" title="Larger text">A+</button>
          </div>
        </div>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="ftr">
      <div class="wrap">
        <div class="foot-top">
          <div>
            <div class="wm">A<i>.</i>S<i>.</i>R</div>
            <div class="c">© MMXXVI · New York · São Paulo</div>
          </div>
          <nav class="foot-social" aria-label="Social links">
            <a href="https://arthur.law/">arthur.law</a>
            <a href="https://arthur.law/contact/">Contact</a>
            <a href="https://huggingface.co/arthrod" target="_blank" rel="noopener noreferrer">HF</a>
            <a href="https://www.linkedin.com/in/arthrod" target="_blank" rel="noopener noreferrer">LI</a>
            <a href="https://github.com/arthrod" target="_blank" rel="noopener noreferrer">GH</a>
          </nav>
        </div>
        <p class="disclaimer">
          Material contract (EX-10) exhibits extracted from SEC EDGAR in near real time.
          Data is public SEC filing information. Not legal or investment advice.
          <strong>Not affiliated with the SEC.</strong>
        </p>
        <p class="disclaimer">
          <strong>Attorney advertising.</strong> This website is for general informational purposes and does not
          create an attorney-client relationship. Legal services are provided only after conflict
          checks, engagement terms, and jurisdictional scope are confirmed. Prior results do not
          guarantee a similar outcome.
        </p>
      </div>
    </footer>
    <nav class="mbar" aria-label="Primary">
      <a class:list={[{ 'is-current': isHome }]} href="/"><b></b>Live</a>
      <a class:list={[{ 'is-current': isBrowse }]} href="/agreements/1"><b></b>Browse</a>
      <a class:list={[{ 'is-current': isSearch }]} href="/search"><b></b>Search</a>
    </nav>
    <script is:inline>
      // Text-size toggle: same control and storage shape as prompting-for-attorneys.
      (function () {
        var KEY = 'asr-size';
        var btns = document.querySelectorAll('.sizes button');
        function apply(s) {
          if (s === 'large') document.documentElement.dataset.size = 'large';
          else delete document.documentElement.dataset.size;
          btns.forEach(function (b) { b.classList.toggle('on', b.dataset.size === s); });
        }
        var saved = 'normal';
        try { saved = localStorage.getItem(KEY) || 'normal'; } catch (e) {}
        apply(saved);
        btns.forEach(function (b) {
          b.addEventListener('click', function () {
            try { localStorage.setItem(KEY, b.dataset.size); } catch (e) {}
            apply(b.dataset.size);
          });
        });
      })();
    </script>
    <script is:inline>
      // WebMCP (experimental) — expose read-only contract tools to in-browser
      // agents. Feature-detected; reuses the same /mcp endpoint as the remote
      // MCP server, so tool behaviour stays in one place. No-ops where unsupported.
      (function () {
        var mc = navigator.modelContext;
        if (!mc || typeof mc.provideContext !== 'function') return;
        async function callMcp(name, args) {
          try {
            var r = await fetch('/mcp', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name: name, arguments: args || {} } }),
            });
            var j = await r.json();
            return (j && j.result) || { content: [{ type: 'text', text: 'Request failed.' }] };
          } catch (e) {
            return { content: [{ type: 'text', text: 'Request failed.' }] };
          }
        }
        try {
          mc.provideContext({
            tools: [
              {
                name: 'search_contracts',
                description: 'Search SEC EX-10 material contracts by keyword (parties, clauses, terms).',
                inputSchema: { type: 'object', properties: { query: { type: 'string' }, limit: { type: 'integer' } }, required: ['query'] },
                execute: function (args) { return callMcp('search_agreements', args); },
              },
              {
                name: 'recent_contracts',
                description: 'List the most recently filed EX-10 material contracts.',
                inputSchema: { type: 'object', properties: { limit: { type: 'integer' } } },
                execute: function (args) { return callMcp('list_recent_agreements', args); },
              },
            ],
          });
        } catch (e) { /* experimental API shape mismatch — ignore */ }
      })();
    </script>
  </body>
</html>
