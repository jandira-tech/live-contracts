---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Inject <meta refresh> for live auto-refresh pages. */
  refreshSeconds?: number;
}

const {
  title = 'SEC EX-10 Live — Material Contracts',
  description = 'Real-time feed of EX-10 material contract exhibits filed with the SEC.',
  refreshSeconds,
} = Astro.props;

// Active nav state from the current path.
const path = Astro.url.pathname;
const isBrowse = path.startsWith('/agreement'); // /agreements/* and /agreement/*
const isSearch = path.startsWith('/search');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {refreshSeconds ? <meta http-equiv="refresh" content={String(refreshSeconds)} /> : null}
    <title>{title}</title>
    <!-- Canonical brand fonts are self-hosted (see global.css @font-face); preload
         the two variable woff2 so first paint isn't blocked on CSS discovery. -->
    <link rel="preload" href="/fonts/libre-franklin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roboto-mono.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' fill='%23FAFAF8'/><rect x='3' y='3' width='5' height='5' fill='%23FFD400'/></svg>" />
  </head>
  <body>
    <nav class="sl-nav">
      <div class="sl-nav-inner">
        <a class="sl-wordmark" href="/"><span class="pulse"></span>LIVECONTRACTS</a>
        <ul class="sl-nav-links">
          <li><a class="sl-nav-link" href="https://arthur.law" target="_blank" rel="noopener">ABOUT ME</a></li>
          <li><a class:list={['sl-nav-link', { 'is-active': isBrowse }]} href="/agreements/1">BROWSE</a></li>
          <li><a class:list={['sl-nav-link', { 'is-active': isSearch }]} href="/search">SEARCH</a></li>
        </ul>
      </div>
    </nav>
    <main class="container">
      <slot />
    </main>
    <footer class="site">
      <div class="container">
        <p>
          Material contract (EX-10) exhibits extracted from SEC EDGAR in near real time.
          Data is public SEC filing information. Not legal or investment advice.
          <span class="footer-strong">NOT AFFILIATED WITH THE SEC.</span>
        </p>
        <p class="footer-fine">
          Attorney advertising. This website is for general informational purposes and does not
          create an attorney-client relationship. Legal services are provided only after conflict
          checks, engagement terms, and jurisdictional scope are confirmed. Prior results do not
          guarantee a similar outcome.
        </p>
        <div class="footer-meta">
          <span>© MMXXVI ARTHUR SOUZA RODRIGUES · NEW YORK · SÃO PAULO</span>
          <nav class="footer-links" aria-label="Social links">
            <a href="https://huggingface.co/arthrod" target="_blank" rel="noopener noreferrer">HF</a>
            <a href="https://www.linkedin.com/in/arthrod" target="_blank" rel="noopener noreferrer">LI</a>
            <a href="https://github.com/arthrod" target="_blank" rel="noopener noreferrer">GH</a>
          </nav>
        </div>
      </div>
    </footer>
    <script is:inline>
      // WebMCP (experimental) — expose read-only contract tools to in-browser
      // agents. Feature-detected; reuses the same /mcp endpoint as the remote
      // MCP server, so tool behaviour stays in one place. No-ops where unsupported.
      (function () {
        var mc = navigator.modelContext;
        if (!mc || typeof mc.provideContext !== 'function') return;
        async function callMcp(name, args) {
          try {
            var r = await fetch('/mcp', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name: name, arguments: args || {} } }),
            });
            var j = await r.json();
            return (j && j.result) || { content: [{ type: 'text', text: 'Request failed.' }] };
          } catch (e) {
            return { content: [{ type: 'text', text: 'Request failed.' }] };
          }
        }
        try {
          mc.provideContext({
            tools: [
              {
                name: 'search_contracts',
                description: 'Search SEC EX-10 material contracts by keyword (parties, clauses, terms).',
                inputSchema: { type: 'object', properties: { query: { type: 'string' }, limit: { type: 'integer' } }, required: ['query'] },
                execute: function (args) { return callMcp('search_agreements', args); },
              },
              {
                name: 'recent_contracts',
                description: 'List the most recently filed EX-10 material contracts.',
                inputSchema: { type: 'object', properties: { limit: { type: 'integer' } } },
                execute: function (args) { return callMcp('list_recent_agreements', args); },
              },
            ],
          });
        } catch (e) { /* experimental API shape mismatch — ignore */ }
      })();
    </script>
  </body>
</html>
