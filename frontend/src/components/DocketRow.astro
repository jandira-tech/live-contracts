---
import type { Ex10Summary } from '../lib/api';
import { formatNY, formatFiledAt } from '../lib/time';
import { displayTitle, textContent } from '../lib/summary';
import { renderMarkdown } from '../lib/render-markdown';

interface Props { item: Ex10Summary; }
const { item } = Astro.props;

// Headline: the real instrument name lifted from the markdown when the SEC
// description is only the exhibit label (94 of 100 live rows). See summary.ts.
const title = displayTitle(item.description, item.excerpt_md || item.excerpt);
const party = item.company_name?.trim() || item.doc_type;
const filedLabel = formatFiledAt(item.filed_at) || formatNY(item.found_at);
const href = `/agreement/${item.id}`;

// What the card body can show, in order of preference:
//   search snippet (FTS hit context) → markdown excerpt → one of three empty states.
const body = (item.excerpt_md || '').trim();
const hasText = textContent(body).length >= 40;
// stripMdHead drops the first image comment, so count the page rules as well.
const imageRefs = Math.max((body.match(/<!--\s*\S+\.(?:jpe?g|png|gif|tiff?)\s*-->/gi) || []).length, (body.match(/^\s*(?:\*{3,}|-{3,}|_{3,})\s*$/gm) || []).length);
const pages = item.image_urls?.length || 0;
const snippet = (item.snippet || '').trim();
const bodyHtml = hasText && !snippet ? renderMarkdown(body) : '';
// snippet() output is plain text plus our <mark> tags; escape everything else.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Drop markdown markers from the plain-text snippet (headings, emphasis, table pipes).
const snippetHtml = snippet ? esc(snippet.replace(/[#*_`>|\\]+/g, '').replace(/\s+/g, ' ')).replace(/&lt;mark&gt;/g, '<mark class="sl-mark">').replace(/&lt;\/mark&gt;/g, '</mark>') : '';

let empty: { label: string; detail: string } | null = null;
if (!hasText && !snippet) {
  if (pages) empty = { label: 'Scanned exhibit', detail: `${pages} page${pages === 1 ? '' : 's'} captured as images` };
  else if (imageRefs) empty = { label: 'Image-only exhibit', detail: `${imageRefs} page${imageRefs === 1 ? '' : 's'} on SEC EDGAR, no extractable text` };
  else if (item.markdown_status === 'pending' || !item.has_markdown) empty = { label: 'Text pending', detail: 'The markdown for this exhibit is still being generated' };
  else empty = { label: 'No preview', detail: 'This exhibit has no text to preview' };
}
---
{/* The whole card is the link: h3 > a carries a stretched ::after over the
    article (see .sl-doc-rail h3 a::after). Inner links sit above it. */}
<article class="sl-doc" data-id={item.id}>
  <div class="sl-doc-rail">
    <h3><a href={href}>{title}</a></h3>
    <p class="sl-doc-party">{party}</p>
  </div>

  <div class="sl-doc-body">
    {snippetHtml ? (
      <div class="sl-doc-extract">
        <div class="sl-doc-extract-inner">
          <p class="sl-snippet" set:html={snippetHtml} />
        </div>
      </div>
    ) : bodyHtml ? (
      <div class="sl-doc-extract">
        <div class="sl-doc-extract-inner">
          <div class="sl-md sl-md-body" set:html={bodyHtml} />
        </div>
      </div>
    ) : empty ? (
      <div class="sl-doc-empty">
        <span class="sl-doc-empty-label">{empty.label}</span>
        <span class="sl-doc-empty-detail">{empty.detail}</span>
      </div>
    ) : null}
    <div class="sl-doc-foot">
      <span class="sl-doc-open">Open document <span class="arr" aria-hidden="true">→</span></span>
    </div>
  </div>

  <div class="sl-doc-meta">
    <span class="k">{item.doc_type}</span>
    <span class="sep">·</span>
    <span class="k">{item.form_type}</span>
    <span class="sep">·</span>
    <span>CIK {item.cik}</span>
    <span class="sep">·</span>
    <span>ACC {item.accession}</span>
    <span class="sep">·</span>
    <span>Filed {filedLabel}</span>
  </div>
</article>
