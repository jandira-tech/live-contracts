---
import type { Ex10Summary } from '../lib/api';
import { formatNY, formatFiledAt } from '../lib/time';

interface Props { item: Ex10Summary; }
const { item } = Astro.props;

const title = item.description?.trim() || `${item.doc_type} — ${item.filename}`;
// Every exhibit is EX-10.*, so the filer (company) is the useful headline pill;
// fall back to the doc type only when the filing header hasn't been parsed yet.
const pill = item.company_name?.trim() || item.doc_type;
// The real SEC acceptance time; fall back to our capture time until backfilled.
const filedLabel = `FILED ${formatFiledAt(item.filed_at) || formatNY(item.found_at)}`;

// Card preview is capped by CHARACTERS (the full text is on the detail page):
// 300 on desktop, ~160 on mobile. Cut on a word/line boundary; the markdown's
// line breaks are preserved via `white-space: pre-line`.
function clip(s: string | undefined, n: number): string {
  const t = (s ?? '').trim();
  if (t.length <= n) return t;
  const cut = t.slice(0, n);
  const b = Math.max(cut.lastIndexOf(' '), cut.lastIndexOf('\n'));
  return (b > n * 0.6 ? cut.slice(0, b) : cut).trimEnd() + '…';
}
const excerptDesktop = clip(item.excerpt, 300);
const excerptMobile = clip(item.excerpt, 160);
---
<a class="sl-row" href={`/agreement/${item.id}`}>
  <div class="sl-row-meta">
    <span class="sl-filer-tag">{pill}</span>
    <span class="form-pill">{item.form_type}</span>
    {item.company_name?.trim() ? <span class="meta-line">{item.doc_type}</span> : null}
    <span class="meta-line">CIK {item.cik}</span>
    <span class="meta-line">{item.accession}</span>
  </div>
  <div class="sl-row-body">
    <h3>{title}</h3>
    {item.excerpt ? (
      <Fragment>
        <p class="excerpt excerpt-d">{excerptDesktop}</p>
        <p class="excerpt excerpt-m">{excerptMobile}</p>
      </Fragment>
    ) : null}
    {!item.excerpt && item.image_urls?.length ? (
      <p class="scanned">📄 Scanned document · {item.image_urls.length} page{item.image_urls.length === 1 ? '' : 's'}</p>
    ) : null}
    <div class="filed">
      <span>{filedLabel}</span>
    </div>
  </div>
</a>
