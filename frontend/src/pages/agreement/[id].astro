---
import Base from '../../layouts/Base.astro';
import { getLiveEntry } from 'astro:content';
import type { Ex10Detail } from '../../lib/api';
import { formatNY } from '../../lib/time';
import { marked } from 'marked';

// Live SSR via Live Content Collections: fetched at request time by id. No
// prerender, no rebuild — every agreement is available the moment it's stored.
const { id } = Astro.params;
const { entry, error } = await getLiveEntry('agreements', { id: id! });

const detail = entry?.data as Ex10Detail | undefined;
if (error || !detail) {
  return Astro.redirect('/404');
}

const html = detail.markdown ? marked.parse(detail.markdown) : '';
const title = detail.description?.trim() || `${detail.doc_type} — ${detail.filename}`;

Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=600');
---
<Base title={title} description={`EX-10 material contract: ${title}`}>
  <section class="hero">
    <div class="meta" style="display:flex;gap:.5rem;flex-wrap:wrap;font-family:var(--mono);font-size:.78rem;color:var(--muted);margin-bottom:.5rem">
      <span class="badge ex10">{detail.doc_type}</span>
      <span class="badge form">{detail.form_type}</span>
      <span class="badge">CIK {detail.cik}</span>
      <span class="badge">{detail.accession}</span>
    </div>
    <h1>{title}</h1>
    <p>
      <a href={detail.filing_url} rel="noopener" target="_blank">View original filing on SEC EDGAR →</a>
      &nbsp;·&nbsp; seen {formatNY(detail.found_at)}
    </p>
  </section>

  <article class="prose">
    {html ? <Fragment set:html={html} /> : <p class="empty">Markdown for this exhibit is still being generated.</p>}
  </article>

  <div class="pagination"><a href="/agreements/1">← Back to all agreements</a></div>
</Base>
