---
import Base from '../layouts/Base.astro';
import AgreementRow from '../components/AgreementRow.astro';
import { getLiveCollection } from 'astro:content';
import { ex10Stats, type Ex10Summary } from '../lib/api';

// Live, request-time: agreements found in the last 60 seconds. Page auto-refreshes
// every 60s (Base refreshSeconds) so the window always shows the newest material
// contracts the backend has captured.
const WINDOW = 60;
const { entries, error } = await getLiveCollection('agreements', { filter: { seconds: WINDOW } });
// getLiveCollection re-sorts entries by id; force newest-by-filing-time first
// (filed_at is the SEC acceptance time; fall back to capture time until backfilled).
const items: Ex10Summary[] = (entries ?? [])
  .map((e) => e.data as Ex10Summary)
  .sort((a, b) =>
    (b.filed_at ?? '').localeCompare(a.filed_at ?? '') ||
    (b.found_at ?? '').localeCompare(a.found_at ?? '') ||
    String(b.id).localeCompare(String(a.id)),  // UUIDv7 is time-ordered lexically
  );
const stats = await ex10Stats();
---
<Base refreshSeconds={WINDOW}>
  <header class="sl-hero">
    <div class="sl-hero-eyebrow">
      <span class="pulse"></span>
      <span>LIVE</span>
      <span class="sep">·</span>
      <span><strong>{stats.total.toLocaleString()}</strong> total agreements</span>
      <span class="sep">·</span>
      <span><strong>{stats.last_24h.toLocaleString()}</strong> last 24h</span>
    </div>
    <h1>New material contract exhibits, the moment they hit SEC EDGAR.</h1>
    <hr class="divider" />
  </header>

  <div class="sl-section-bar">
    <span class="title">New agreements</span>
    <span class="meta">last {WINDOW}s · {items.length} shown</span>
  </div>

  {error ? (
    <div class="empty">The live feed is temporarily unavailable. Retrying on next refresh…</div>
  ) : items.length === 0 ? (
    <div class="empty">No new EX-10 agreements in the last {WINDOW} seconds. Watching the wire…</div>
  ) : (
    <section class="sl-feed">
      {items.map((item) => <AgreementRow item={item} />)}
    </section>
  )}

  <a class="sl-tail-link" href="/agreements/1">Browse all agreements →</a>
</Base>
