---
import Base from '../layouts/Base.astro';
import AgreementCard from '../components/AgreementCard.astro';
import { getLiveCollection } from 'astro:content';
import { ex10Stats, type Ex10Summary } from '../lib/api';

// Live, request-time: agreements found in the last 60 seconds. Page auto-refreshes
// every 60s (Base refreshSeconds) so the window always shows the newest material
// contracts the backend has captured.
const WINDOW = 60;
const { entries, error } = await getLiveCollection('agreements', { filter: { seconds: WINDOW } });
const items: Ex10Summary[] = (entries ?? []).map((e) => e.data as Ex10Summary);
const stats = await ex10Stats();
---
<Base refreshSeconds={WINDOW}>
  <header class="sl-hero">
    <div class="sl-hero-eyebrow">
      <span class="pulse"></span>
      <span>LIVE</span>
      <span class="sep">·</span>
      <span>refreshing every {WINDOW}s</span>
      <span class="sep">·</span>
      <span class="countdown">next in <span id="cd" data-window={WINDOW}>{WINDOW}</span>s</span>
    </div>
    <h1>New material contract exhibits, the moment they hit SEC EDGAR.</h1>
    <p class="lede">
      Traditional EX-10 material contracts — credit agreements, employment terms, license deals,
      indemnification forms — extracted from public SEC filings in near real time. No login, no paywall.
    </p>
    <hr class="divider" />
  </header>

  <div class="stats-strip">
    <span><strong>{stats.total.toLocaleString()}</strong> total</span>
    <span><strong>{stats.last_24h.toLocaleString()}</strong> in last 24h</span>
    <span><strong>{stats.with_markdown.toLocaleString()}</strong> with markdown</span>
  </div>

  {error ? (
    <div class="empty">The live feed is temporarily unavailable. Retrying on next refresh…</div>
  ) : items.length === 0 ? (
    <div class="empty">No new EX-10 agreements in the last {WINDOW} seconds. Watching the wire…</div>
  ) : (
    <div class="grid">
      {items.map((item) => <AgreementCard item={item} />)}
    </div>
  )}

  <div class="pagination">
    <a href="/agreements/1">Browse all agreements →</a>
  </div>

  <script>
    // Tick the hero countdown to the next meta-refresh. Compute against a fixed
    // target so the display stays accurate even if the tab is backgrounded and
    // setInterval is throttled (a plain decrement would drift).
    const el = document.getElementById('cd');
    if (el) {
      const target = Date.now() + (Number(el.dataset.window) || 60) * 1000;
      setInterval(() => {
        const remaining = Math.max(0, Math.ceil((target - Date.now()) / 1000));
        el.textContent = String(remaining).padStart(2, '0');
      }, 1000);
    }
  </script>
</Base>
