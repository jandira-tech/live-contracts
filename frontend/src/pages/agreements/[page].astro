---
import Base from '../../layouts/Base.astro';
import AgreementRow from '../../components/AgreementRow.astro';
import { listEx10, ex10Facets } from '../../lib/api';

// Live SSR (no prerender): request-time, paginated, query-param driven filters.
const pageParam = Number(Astro.params.page);
if (!Number.isInteger(pageParam) || pageParam < 1) {
  return Astro.redirect('/agreements/1');
}

const sp = Astro.url.searchParams;
const form = sp.get('form') || undefined;
const cik = sp.get('cik') || undefined;
const filer = sp.get('filer') || undefined;
const sort: 'newest' | 'oldest' = sp.get('sort') === 'oldest' ? 'oldest' : 'newest';

const PAGE_SIZE = 12;
const [result, facetsRes] = await Promise.all([
  listEx10(pageParam, PAGE_SIZE, { form, cik, filer, sort }),
  ex10Facets(),
]);
const lastPage = Math.max(1, result.total_pages ?? 0);

function buildQS(over: Record<string, string | undefined> = {}): string {
  const merged = { form, cik, filer, sort, ...over };
  const p = new URLSearchParams();
  if (merged.form) p.set('form', merged.form);
  if (merged.cik) p.set('cik', merged.cik);
  if (merged.filer) p.set('filer', merged.filer);
  if (merged.sort === 'oldest') p.set('sort', 'oldest');
  const s = p.toString();
  return s ? `?${s}` : '';
}
const pageHref = (n: number) => `/agreements/${n}${buildQS()}`;
const filterHref = (over: Record<string, string | undefined>) => `/agreements/1${buildQS(over)}`;

if (pageParam > lastPage && result.total > 0) {
  return Astro.redirect(pageHref(lastPage));
}
const prev = pageParam > 1 ? pageParam - 1 : null;
const next = pageParam < lastPage ? pageParam + 1 : null;
const filtered = Boolean(form || cik || filer);

Astro.response.headers.set('Cache-Control', 'public, max-age=30, stale-while-revalidate=60');
---
<Base title={`Browse EX-10 agreements${form ? ` · ${form}` : ''}`}>
  <header class="sl-hero">
    <div class="sl-hero-eyebrow"><span>BROWSE</span><span class="sep">·</span><span>page {pageParam} of {lastPage}</span></div>
    <h1>Browse EX-10 agreements</h1>
    <p class="lede">{(result.total ?? 0).toLocaleString()} {filtered ? 'matching' : 'total'} material contract exhibits.</p>
    <hr class="divider" />
  </header>

  <div class="sl-browse-layout">
    <aside class="sl-filters-col">
      <div class="sl-filters">
        <h4>Sort</h4>
        <ul>
          <li class:list={[{ 'is-active': sort === 'newest' }]}><a href={filterHref({ sort: undefined })}>Newest</a></li>
          <li class:list={[{ 'is-active': sort === 'oldest' }]}><a href={filterHref({ sort: 'oldest' })}>Oldest</a></li>
        </ul>
      </div>
      <div class="sl-filters">
        <h4>Filing type</h4>
        <ul>
          <li class:list={[{ 'is-active': !form }]}><a href={filterHref({ form: undefined })}>All</a></li>
          {facetsRes.forms.map((f) => (
            <li class:list={[{ 'is-active': form === f.form_type }]}>
              <a href={filterHref({ form: f.form_type })}>{f.form_type}<span class="count">{f.count.toLocaleString()}</span></a>
            </li>
          ))}
        </ul>
      </div>
      <div class="sl-filters">
        <h4>Filer / CIK</h4>
        <form method="get" action="/agreements/1" class="sl-filter-search">
          <input type="search" name="filer" value={filer} placeholder="Company name" aria-label="Filer name" />
          <input type="search" name="cik" value={cik} placeholder="CIK" aria-label="CIK" />
          {form ? <input type="hidden" name="form" value={form} /> : null}
          {sort === 'oldest' ? <input type="hidden" name="sort" value="oldest" /> : null}
          <button type="submit">Apply</button>
          {filtered ? <a class="sl-filter-clear" href="/agreements/1">Clear filters</a> : null}
        </form>
      </div>
    </aside>

    <div>
      {result.items.length === 0 ? (
        <div class="empty">No agreements match these filters.</div>
      ) : (
        <section class="sl-feed">
          {result.items.map((item) => <AgreementRow item={item} />)}
        </section>
      )}

      <nav class="pagination" aria-label="Pagination">
        {pageParam > 1 ? <a href={pageHref(1)}>« First</a> : <span class="disabled">« First</span>}
        {prev ? <a href={pageHref(prev)}>‹ Prev</a> : <span class="disabled">‹ Prev</span>}
        <span class="current">{pageParam} / {lastPage}</span>
        {next ? <a href={pageHref(next)}>Next ›</a> : <span class="disabled">Next ›</span>}
        {pageParam < lastPage ? <a href={pageHref(lastPage)}>Last »</a> : <span class="disabled">Last »</span>}
      </nav>
    </div>
  </div>
</Base>
