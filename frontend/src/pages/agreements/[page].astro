---
import Base from '../../layouts/Base.astro';
import AgreementCard from '../../components/AgreementCard.astro';
import { listEx10 } from '../../lib/api';

// Live SSR (no prerender): request-time fetch from the API, paginated. Fresh on
// every request — no rebuild, no redeploy needed when new agreements arrive.
const pageParam = Number(Astro.params.page);
if (!Number.isInteger(pageParam) || pageParam < 1) {
  return Astro.redirect('/agreements/1');
}

const PAGE_SIZE = 12;
const result = await listEx10(pageParam, PAGE_SIZE);
const lastPage = Math.max(1, result.total_pages ?? 0);

if (pageParam > lastPage && result.total > 0) {
  return Astro.redirect(`/agreements/${lastPage}`);
}

const prev = pageParam > 1 ? pageParam - 1 : null;
const next = pageParam < lastPage ? pageParam + 1 : null;

// Edge cache: serve instantly, revalidate in the background.
Astro.response.headers.set('Cache-Control', 'public, max-age=30, stale-while-revalidate=60');
---
<Base title={`Agreements — page ${pageParam}`}>
  <section class="hero">
    <h1>All EX-10 agreements</h1>
    <p>{(result.total ?? 0).toLocaleString()} material contract exhibits · page {pageParam} of {lastPage}</p>
  </section>

  {result.items.length === 0 ? (
    <div class="empty">No agreements available right now.</div>
  ) : (
    <div class="grid">
      {result.items.map((item) => <AgreementCard item={item} />)}
    </div>
  )}

  <nav class="pagination" aria-label="Pagination">
    {pageParam > 1 ? <a href="/agreements/1">« First</a> : <span class="disabled">« First</span>}
    {prev ? <a href={`/agreements/${prev}`}>‹ Prev</a> : <span class="disabled">‹ Prev</span>}
    <span class="current">{pageParam} / {lastPage}</span>
    {next ? <a href={`/agreements/${next}`}>Next ›</a> : <span class="disabled">Next ›</span>}
    {pageParam < lastPage ? <a href={`/agreements/${lastPage}`}>Last »</a> : <span class="disabled">Last »</span>}
  </nav>
</Base>
